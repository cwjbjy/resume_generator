# Prefer ./init-env.ps1 to generate secure local values automatically.
# dev enables demo accounts + mock payment + refund. prod disables these.
APP_PROFILE=dev
DB_PASSWORD=replace-with-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-random-root-password
REDIS_PASSWORD=replace-with-random-redis-password
JWT_SECRET=replace-with-at-least-32-random-characters
PAYMENT_SECRET=replace-with-random-payment-signing-secret
